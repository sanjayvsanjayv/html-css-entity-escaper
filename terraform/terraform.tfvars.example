# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored — never commit it.

aws_region       = "ap-south-1"
project_name     = "entity-escaper"
environment      = "dev"

# "student" (Option B, recommended) or "production" (Option A, full EKS)
deployment_mode  = "student"

vpc_cidr             = "10.20.0.0/16"
public_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]

instance_type    = "t3.small"

# Only used when deployment_mode = "production"
eks_node_instance_type = "t3.medium"
eks_node_desired_size  = 2

# Create this key pair in AWS first: aws ec2 create-key-pair --key-name entity-escaper-key
ssh_key_name     = "REPLACE_WITH_YOUR_KEY_PAIR_NAME"

# Restrict to YOUR IP, e.g. "203.0.113.10/32" — never leave as 0.0.0.0/0
allowed_ssh_cidr = "REPLACE_WITH_YOUR_IP/32"
